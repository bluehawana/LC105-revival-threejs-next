# ---------------------------------------------------------------------------
# LC105 Revival — environment
# Copy this file to `.env.local` and fill in what you need.
#
# The 3D assembly works with NO configuration at all. Everything below is
# only for the optional "Ask Qwen" AI guide. With no key set, the guide still
# works — it answers from the built-in parts catalog in "offline mode".
# ---------------------------------------------------------------------------

# DashScope / Qwen API key (Alibaba Cloud Model Studio, or QwenCloud sk-ws-*).
# Leave blank to run the guide in offline mode.
DASHSCOPE_API_KEY=

# Which Qwen model to call. The user's "Qwen 3.8" maps to the qwen3.8 family.
QWEN_MODEL=qwen3.8-max

# OpenAI-compatible endpoint. "intl" works globally; swap to a regional
# maas endpoint if you prefer (see .env comments in app/api/ask/route.ts).
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
